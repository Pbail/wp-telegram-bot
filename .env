# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUvwxYZ

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/wa_bot

# Your own Telegram numeric user ID -> full unrestricted owner access
OWNER_ID=123456789

# Text shown to non-paid, non-owner users
BLOCK_MESSAGE=Get lost! By @MR_Pbail

# Telegram group ID where all bot logs (logins, errors, new users) are posted.
# Add your bot to a group, send any message there, then open:
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
# and copy the "chat":{"id": ...} value (it will be a negative number).
LOG_GROUP_ID=-1001234567890

# Set to false once things are working, to reduce log-group noise.
# When true, every single incoming WhatsApp message/call logs a debug line.
VERBOSE_LOGS=true
